# Copy this file to .env and fill in your keys. The .env file is gitignored.
#   cp .env.example .env
#
# Values set in your shell (e.g. `GITHUB_TOKEN=... python script.py`) take
# precedence over anything in .env.

# GitHub personal access token. Raises the API limit from 60/hr (unauthenticated)
# to 5,000/hr. Used by annotate/sample.py and annotate/extraction.py (including
# merged-PR discovery). A token with no scopes is enough for public repositories.
GITHUB_TOKEN=

# OpenRouter API key. Used for annotation (annotate/annotate_openrouter.py), the
# harness predictor and judge (harness/), the RL judge reward (rl/), and judging
# SFT predictions (sft/).
OPENROUTER_API_KEY=

# Annotation model (optional; defaults to ~openai/gpt-latest). The paper's
# annotations used GPT-5.6 Sol with xhigh reasoning.
OPENROUTER_MODEL=~openai/gpt-latest

# Optional alternative backends: OpenAI/Codex keys for annotate/annotate_codex.py and
# the *_codex.py judges; CODEX_CLI overrides the path of the `codex` executable.
# OPENAI_API_KEY=
# CODEX_API_KEY=
# CODEX_CLI=codex

# Maximum output tokens for each structured annotation call (optional).
# OPENROUTER_MAX_TOKENS=16000

# Annotation request packing (optional). annotate/annotate_openrouter.py normally reads the model's
# context window from OpenRouter, reserves OPENROUTER_MAX_TOKENS for output, and
# uses 90% of the remainder for input. Set the context explicitly when model
# metadata lookup is unavailable. Source-heavy JSON is conservatively estimated
# at three characters per token.
# OPENROUTER_CONTEXT_TOKENS=
# ANNOTATE_CONTEXT_UTILIZATION=0.90
# ANNOTATE_CHARS_PER_TOKEN=3.0
# ANNOTATE_UNIT_CHARS=30000

# Maximum historical Git blob size downloaded by extraction.py (optional; 2 MiB).
# Larger files are recorded as omitted instead of fetched lazily one at a time.
# EXTRACTION_GIT_BLOB_LIMIT=2097152

# Evidence limits used only by annotate/extraction.py (optional).
# Source/config/notebook files are read once when created, up to the corresponding
# cap. Their later changes contain only diffs. Python's default is intentionally
# larger than shell's. Excluded content still receives a manifest record.
# EXTRACTION_PYTHON_CREATION_CHARS=48000
# EXTRACTION_SHELL_CREATION_CHARS=12000
# EXTRACTION_SOURCE_CREATION_CHARS=32000
# EXTRACTION_CONFIGURATION_CREATION_CHARS=16000
# EXTRACTION_NOTEBOOK_CREATION_CHARS=48000
# EXTRACTION_MAX_FILE_PATCH_CHARS=32000
# EXTRACTION_TEXT_PREVIEW_CHARS=6000
# EXTRACTION_PATCH_CHARS=16000

# Optional HTTP-Referer header for OpenRouter attribution.
# OPENROUTER_REFERER=
